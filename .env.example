# LLM API Key (Groq - free tier available at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Vector Store Settings
# VECTOR_STORE_TYPE can be 'chroma' (local, zero cloud key needed) or 'pinecone'
VECTOR_STORE_TYPE=chroma

# Pinecone (Required only if VECTOR_STORE_TYPE=pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=payslate-rag-docs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Embeddings Model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
